---
import MainLayout from "@layouts/main-layout.astro";
import Title from "@components/atoms/text/title.astro";
import ListProyects from "@components/cells/list-proyects.astro";
import en from "../../locales/en-GB.json";
import es from "../../locales/es-MX.json";

export async function getStaticPaths() {
  return [
    { params: { lang: 'en-GB' } },
    { params: { lang: 'es-MX' } },
  ];
}

const { lang } = Astro.params;
const i18n = (lang === 'es-MX' ? es : en) as any;
const title = i18n.projects?.title ?? i18n['projects.title'] ?? 'Projects';
---

<MainLayout title={title} lang={lang}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Title class="mb-6">{title}</Title>
    <p class="mb-6">{i18n.projects?.description ?? i18n['projects.description'] ?? ''}</p>
    <ListProyects />
  </div>
</MainLayout>
