---
import MainLayout from "@layouts/main-layout.astro";
import Title from "@components/atoms/text/title.astro";
import Paragraph from "@components/atoms/text/paragraph.astro";
import en from "../../locales/en-GB.json";
import es from "../../locales/es-MX.json";
import ListProyects from "@components/cells/list-projects.astro";
import { FavoriteProjects } from "@components/cells/FavoriteProjects";
import { DeploymentsList } from "@components/cells/DeploymentsList";
import {
  fetchLatestDeploymentStatus,
  fetchRepositories,
} from "@service/githubService";
import type { GitHubRepository } from "@typings/github";
import type { GitHubDeploymentStatus } from "@typings/github";

export async function getStaticPaths() {
  return [{ params: { lang: "en-GB" } }, { params: { lang: "es-MX" } }];
}

const { lang } = Astro.params;
const i18n = lang === "es-MX" ? es : en;
const title = i18n.home.title;
const subtitle = i18n.home.subtitle;
const description = i18n.home.description;
const repositories = await fetchRepositories("Cesar-Plyed");
const repos: GitHubRepository[] =
  repositories instanceof Error ? [] : repositories;
const deploymentResults = await Promise.all(
  repos.map(async (repo): Promise<GitHubDeploymentStatus | null> => {
    const deployment = await fetchLatestDeploymentStatus(
      "Cesar-Plyed",
      repo.name,
    );
    if (!deployment || deployment instanceof Error) return null;

    return {
      ...deployment,
      repository_url: deployment.repository_url || repo.html_url,
      repository_name: repo.name,
    };
  }),
);
const deployments: GitHubDeploymentStatus[] = deploymentResults.filter(
  (deployment): deployment is GitHubDeploymentStatus => deployment !== null,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="overflow-x-hidden dark:bg-black">
    <MainLayout title={title}>
      <div class="max-w-5xl px-4 py-12 mx-auto sm:px-6 lg:px-8">
        <Title class="mb-6">{subtitle}</Title>
        <Paragraph class="mb-4">
          {description}
        </Paragraph>

        <!-- favorites are purely client‑side since they rely on fetch/useEffect -->
        <section class="mb-8 space-y-6">
          <h2 class="text-2xl font-semibold dark:text-white">
            {i18n.home.favoritesTitle || "Favorites"}
          </h2>
          <FavoriteProjects
            client:load
            favoriteNames={["XDJA", "ExploteFuit", "Role-Based-Dashboard"]}
            initialRepos={repos}
          />
        </section>

        <div
          class="mt-12"
        >
          <div class="space-y-8">
            <ListProyects initialRepos={repos} />
          </div>
        </div>
      </div>
      <aside class="w-full lg:justify-self-end">
        <div
          class="fixed right-0 top-1/2 z-20 w-80 max-w-[calc(100vw-1rem)] -translate-y-1/2"
        >
          <DeploymentsList client:load initialRepos={deployments} />
        </div>
      </aside>
    </MainLayout>
  </body>
</html>
