---
import MainLayout from "@layouts/main-layout.astro";
import {
  fetchLatestDeploymentStatus,
  fetchRepositories,
} from "../../../services/githubService";
import type { GitHubRepository } from "@typings/github";

export async function getStaticPaths() {
  const repos = await fetchRepositories("Cesar-Plyed");

  if (repos instanceof Error) {
    console.error(repos.message);
    return [];
  }

  const langs = ["en-GB", "es-MX"];

  return langs.flatMap((lang) =>
    repos.map((repo: GitHubRepository) => ({
      params: { lang, repo: repo.name },
      props: { repo },
    })),
  );
}

const { lang, repo } = Astro.params;
const { repo: repoData } = Astro.props;
const i18n =
  lang === "es-MX"
    ? (await import("../../../locales/es-MX.json")).default
    : (await import("../../../locales/en-GB.json")).default;
const deployment = await fetchLatestDeploymentStatus("Cesar-Plyed", repo);
const deploymentUrl =
  deployment && !(deployment instanceof Error)
    ? deployment.environment_url || deployment.target_url
    : null;
---

<MainLayout title={repo}>
  <main
    class="min-h-screen bg-(--color-neutral-50) px-4 py-10 text-(--color-neutral-900) dark:bg-(--color-dark-bg) dark:text-(--color-neutral-100) sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl">
      <a
        href={`/${lang}/`}
        class="mb-8 inline-flex items-center text-sm font-semibold text-(--color-primary) transition-colors hover:text-(--color-primary-dark)"
      >
        &larr; {i18n.home.title2}
      </a>

      <section
        class="overflow-hidden rounded-2xl border border-(--color-neutral-200) bg-white shadow-xl dark:border-(--color-neutral-800) dark:bg-(--color-dark-surface)"
      >
        <div
          class="border-b border-(--color-neutral-200) bg-neutral-100/60 px-6 py-8 dark:border-(--color-neutral-800) dark:bg-dark-surface-elevated/60 sm:px-10"
        >
          <div
            class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
          >
            <div class="min-w-0">
              <p
                class="mb-2 text-xs font-bold uppercase tracking-wider text-(--color-primary)"
              >
                GitHub repository
              </p>
              <h1
                class="wrap-break-word text-3xl font-bold tracking-tight sm:text-4xl"
              >
                {repo}
              </h1>
            </div>
            <a
              href={repoData.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex shrink-0 items-center justify-center rounded-lg bg-(--color-primary) px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-(--color-primary-dark)"
            >
              {i18n["repo.github"]}
            </a>
          </div>
        </div>

        <div
          class="grid gap-8 px-6 py-8 sm:px-10 lg:grid-cols-[minmax(0,1fr)_16rem]"
        >
          <div class="space-y-8">
            <div>
              <h2
                class="mb-3 text-sm font-bold uppercase tracking-wider text-(--color-neutral-500)"
              >
                {i18n["repo.description"]}
              </h2>
              <p
                class=" text-lg text-(--color-neutral-600) dark:text-(--color-neutral-300)"
              >
                {repoData.description || i18n["repo.noDescription"]}
              </p>
            </div>

            <div class="flex flex-wrap gap-3">
              <div
                class="rounded-lg border border-(--color-neutral-200) px-4 py-3 dark:border-(--color-neutral-700)"
              >
                <p
                  class="text-xs font-semibold uppercase tracking-wide text-(--color-neutral-500)"
                >
                  {i18n["repo.stars"]}
                </p>
                <p class="mt-1 text-xl font-bold">
                  {repoData.stargazers_count}
                </p>
              </div>
              {
                repoData.language && (
                  <div class="rounded-lg border border-(--color-neutral-200) px-4 py-3 dark:border-(--color-neutral-700)">
                    <p class="text-xs font-semibold uppercase tracking-wide text-(--color-neutral-500)">
                      {i18n["repo.language"]}
                    </p>
                    <p class="mt-1 text-xl font-bold">{repoData.language}</p>
                  </div>
                )
              }
            </div>
          </div>

          <aside
            class="self-start rounded-xl border border-(--color-neutral-200) bg-(--color-neutral-50) p-5 dark:border-(--color-neutral-700) dark:bg-(--color-dark-surface-elevated)"
          >
            <p
              class="text-xs font-bold uppercase tracking-wider text-(--color-neutral-500)"
            >
              Deployment
            </p>
            {
              deploymentUrl ? (
                <a
                  href={deploymentUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-emerald-700"
                >
                  {i18n["deploy.label"]}
                </a>
              ) : (
                <p class="mt-3 text-sm leading-6 text-(--color-neutral-600) dark:text-(--color-neutral-300)">
                  {i18n["repo.noDeploy"]}
                </p>
              )
            }
          </aside>
        </div>
      </section>
    </div>
  </main>
</MainLayout>
