---
const language = async function getStaticPaths() {
    return [{ params: { lang: "en-GB" } }, { params: { lang: "es-MX" } }];
}
const { lang } = Astro.params;
const target = lang == 'es-MX' ? 'es-MX' : 'en-GB'
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta http-equiv="refresh" content="0;url=/es-MX/" />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>/es-MX/</a></p>
  </body>
</html>
