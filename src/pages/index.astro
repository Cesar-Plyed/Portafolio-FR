---
// Layout
import MainLayout from "../layouts/main-layout.astro";

// Texts
import Paragraph from "@components/atoms/text/paragraph.astro";
import Title from "@components/atoms/text/title.astro";

// Components
import ListProyects from "@components/cells/list-proyects.astro";

// Title
const title = "Cesar's Portfolio";

---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <script src="../shared/windows-theme.js" />
    </head>
    <body class="dark:bg-black">
        <MainLayout title={title}>
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
                <Title class="mb-6">Welcome to My Portfolio</Title>
                <Paragraph class="mb-4">
                    This is a demonstration of all my github projects
                </Paragraph>
                
                <div class="space-y-8 mt-12">
                    <ListProyects />
                </div>
            </div>
        </MainLayout>
    </body>
</html>
