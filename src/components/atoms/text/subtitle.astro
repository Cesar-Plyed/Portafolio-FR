---
interface Props {
  class?: string ;
  as?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p';
  size?: 'sm' | 'md' | 'lg';
}

const { 
  as: Tag = 'h2', 
  size = 'md',
  class: className = ''
} = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  'sm' : 'text-base md:text-lg',
  'md': 'text-lg md:text-xl',
  'lg': 'text-xl md:text-2xl'
};

const baseClasses = "font-medium tracking-tight text-balance text-neutral-700 dark:text-neutral-300";
---

<Tag class:list={[baseClasses, sizeClasses[size], className]}>
  <slot />
</Tag>
