---
interface Props {
  class?: string;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
}

const { 
  as: Tag = 'h1', 
  size = 'xl',
  class: className = ''
} = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  'sm': 'text-xl md:text-2xl',
  'md': 'text-2xl md:text-3xl',
  'lg': 'text-3xl md:text-4xl',
  'xl': 'text-4xl md:text-5xl',
  '2xl': 'text-5xl md:text-6xl'
};

const baseClasses = "font-semibold tracking-tight text-balance text-neutral-900 dark:text-neutral-50";
---

<Tag class:list={[baseClasses, sizeClasses[size!], className]}>
  <slot />
</Tag>
